# Neon (Postgres) — Drizzle ORM connection string
DATABASE_URL=

# 한국투자증권 — 실전 도메인 · 조회 전용 (재무비율/시세). 절대 주문에 사용하지 않음.
KIS_REAL_APPKEY_READONLY=
KIS_REAL_APPSECRET_READONLY=

# 한국투자증권 — 모의 도메인 · 주문/잔고 전용
# TR_ID는 실전투자와 다름 — 개발자센터에서 모의투자용 코드를 확인해 상수로 분리할 것
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_MOCK_APPKEY=
KIS_MOCK_APPSECRET=
KIS_MOCK_ACCOUNT=

# Anthropic
ANTHROPIC_API_KEY=
